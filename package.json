{
  "name": "personal-design",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "portless",
    "dev:direct": "pnpm --filter @personal-design/web dev",
    "build": "pnpm --filter @personal-design/web build",
    "start": "pnpm --filter @personal-design/web start",
    "lint": "pnpm --filter @personal-design/web lint",
    "test": "node --test \"apps/web/lib/*.test.mjs\" \"packages/*/src/*.test.mjs\" \"packages/*/scripts/*.test.mjs\"",
    "format": "oxfmt --write 'apps/web/{app,components,lib}/**/*.{ts,tsx}' 'apps/web/*.{ts,mjs}' 'packages/*/src/**/*.ts' 'packages/*/scripts/**/*.mjs'",
    "format:check": "oxfmt --check 'apps/web/{app,components,lib}/**/*.{ts,tsx}' 'apps/web/*.{ts,mjs}' 'packages/*/src/**/*.ts' 'packages/*/scripts/**/*.mjs'",
    "typecheck": "pnpm -r typecheck",
    "sync:layouts": "pnpm --filter @personal-design/layout-compositions sync",
    "sync:design-engineer-tools": "pnpm --filter @personal-design/design-engineer-tools sync",
    "sync:ai-coding-dictionary": "pnpm --filter @personal-design/ai-coding-dictionary sync",
    "sync:personal-sites": "pnpm --filter @personal-design/personal-sites sync",
    "sync:inspora": "pnpm --filter @personal-design/inspora sync",
    "test:portfolio-api": "node --test scripts/portfolio-api.test.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0",
    "playwright": "1.63.0"
  }
}
