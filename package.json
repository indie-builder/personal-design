{
  "name": "personal-design",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "portless",
    "build": "pnpm --filter @personal-design/web build",
    "start": "portless --script start",
    "lint": "pnpm --filter @personal-design/web lint && pnpm lint:scripts",
    "lint:scripts": "apps/web/node_modules/.bin/oxlint --deny-warnings scripts",
    "check:navigation": "node scripts/check-navigation.mjs",
    "test:navigation": "node --test scripts/check-navigation.test.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:http": "node scripts/design-checks/run-http.mjs",
    "check:browser": "node scripts/design-checks/run-all.mjs",
    "check:chat": "node scripts/design-checks/run-chat.mjs",
    "test": "node --test \"apps/web/lib/*.test.mjs\" \"packages/*/src/*.test.mjs\" \"packages/*/scripts/*.test.mjs\" \"scripts/check-*.test.mjs\" \"scripts/design-checks/*.test.mjs\"",
    "format": "oxfmt --write 'apps/web/{app,components,lib}/**/*.{ts,tsx}' 'apps/web/*.{ts,mjs}' 'packages/*/src/**/*.ts' 'packages/*/scripts/**/*.mjs'",
    "format:check": "oxfmt --check 'apps/web/{app,components,lib}/**/*.{ts,tsx}' 'apps/web/*.{ts,mjs}' 'packages/*/src/**/*.ts' 'packages/*/scripts/**/*.mjs'",
    "typecheck": "pnpm -r typecheck",
    "sync:layouts": "pnpm --filter @personal-design/layout-compositions sync",
    "sync:design-engineer-tools": "pnpm --filter @personal-design/design-engineer-tools sync",
    "sync:personal-sites": "pnpm --filter @personal-design/personal-sites sync",
    "sync:inspora": "pnpm --filter @personal-design/inspora sync",
    "test:portfolio-api": "node --test scripts/portfolio-api.test.mjs",
    "sync:ai-chat-avatars": "pnpm --filter @personal-design/ai-chat sync:avatars"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "playwright": "1.63.0"
  }
}
